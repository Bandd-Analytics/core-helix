# Phase 8.4 INFRA-01 — Supabase OHLCV cache
# Get this from: Supabase Dashboard -> project nubmgoyyndtolsjyynln -> Connect -> Session pooler -> URI
# Format: postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# IMPORTANT: Use port 5432 (Session pooler) — port 6543 (Transaction pooler) breaks prepared statements
SUPABASE_DB_URL=postgresql://postgres.nubmgoyyndtolsjyynln:REPLACE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres

