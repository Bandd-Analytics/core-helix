# Python
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# Claude Code per-machine API key helper (reads from .env)
.claude/anthropic-key-helper.sh

# Data & databases
*.db
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.csv
*.bin

# Track canonical OHLC CSVs (Phase 8.4 INFRA-02 / D-08 — used as Linux failover
# data source when MT5/Wine unavailable; updated via Path A MT5 GUI export).
!V2/data/*_4yr.csv
!V2/data/*_DAILY*.csv

# ChromaDB & mempalace
.mempalace/
data/chroma_rag/
**/chroma_rag/

# Generated backtest reports
V2/reports/*
# Phase 8.4 Plan 04 INFRA-04 / D-17: trades_sample.csv is a committed fixture
# read by V2/indicators/BandD_TradeReplay.mq5 for operator visual verification
!V2/reports/trades_sample.csv

# IDE / tool artifacts
entities.json

# Third-party libraries (too large for git — install separately)
V2/vectorbtpro/
V2/vbt/
V2/vbt-branches/

# Sealed layer — top-secret IP, never tracked by git.
# See SEALED-LAYER.md for the rule. Only .gitkeep preserves the directory.
sealed/*
!sealed/.gitkeep
**/sealed/*
!**/sealed/.gitkeep

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# MemPalace per-project files (issue #185)
# Phase 8.4 D-20 — keep mempalace.yaml tracked as documentation of the
# project's room/keyword taxonomy (the actual palace state lives at
# ~/.mempalace/palace/). DO NOT re-run `mempalace init` after editing
# (RESEARCH Pitfall 7 — init overwrites the YAML).
# mempalace.yaml  -- intentionally NOT ignored

# Phase 12 — compiled MetaEditor outputs (recompilable from .mq4/.mq5 source)
*.ex5
*.ex4
# But preserve the original non-decompilable Phase 11 source binaries
!resource_pack/MMM/SM Indicators/MT4/!SM.Indicators/*.ex4
